# ── Supabase ──
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres

# ── Backend ──
API_SECRET_KEY=your-secret-key-here
CORS_ORIGINS=http://localhost:5173

# ── Webhook de Disparo ──
# URL para onde o backend envia as mensagens (n8n, Evolution, etc.)
DISPATCH_WEBHOOK_URL=http://seu-n8n:5678/webhook/otear-disparo
DISPATCH_WEBHOOK_SECRET=your-webhook-secret

# ── Webhook de Retorno ──
# Secret para validar webhooks recebidos (status de entrega/leitura)
INBOUND_WEBHOOK_SECRET=your-inbound-secret

# ── App ──
TIMEZONE=America/Sao_Paulo
DEFAULT_LANGUAGE=pt-BR
