{
  "name": "O Tear - Message Queue Processor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "A cada 2 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "id": "check-business-hours",
              "leftValue": "={{ $now.hour }}",
              "rightValue": 9,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "check-business-hours-end",
              "leftValue": "={{ $now.hour }}",
              "rightValue": 18,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-hours",
      "name": "Horário Comercial?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.OTEAR_BACKEND_URL}}/api/messages/next-batch?batch_size=5",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.OTEAR_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-batch",
      "name": "Buscar Lote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [690, 260]
    },
    {
      "parameters": {},
      "id": "no-op-fora-horario",
      "name": "Fora do Horário",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [690, 400]
    }
  ],
  "connections": {
    "A cada 2 minutos": {
      "main": [
        [
          {
            "node": "Horário Comercial?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Horário Comercial?": {
      "main": [
        [
          {
            "node": "Buscar Lote",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fora do Horário",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "tags": [
    {
      "name": "O Tear Prospecção"
    }
  ]
}
