# =============================================================================
# AGI Agentes - exemplo de ambiente atual
# =============================================================================
# Copie para .env e preencha apenas o que for necessario para o seu deploy.
# Se voce quer o minimo para rodar o chat/orquestrador agora, configure um
# provider LLM por API key. Recomendado:
#
#   MODEL_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-...
#   OPENROUTER_MODEL=openai/gpt-4o-mini
#
#   TRANSCRIPTION_PROVIDER=local  # ou openai/groq se tiver a chave respectiva
#
# Importante: OpenRouter/Anthropic/Gemini sao providers de texto. Transcricao de
# audio usa local, OpenAI Whisper ou Groq no bloco "Transcricao".
#
# O docker-compose.yml atual sobe:
#   - gateway/API principal
#   - redis
#   - carousel
#   - remotion
#   - chatgpt-bridge
#
# Nao coloque segredos reais neste arquivo.

# -----------------------------------------------------------------------------
# Aplicacao e acesso
# -----------------------------------------------------------------------------
ENV=production
PORT=8000
ADMIN_PASSWORD=
API_KEY=
ENABLE_DOCS=false

# URLs publicas usadas para montar links retornados ao frontend/agentes.
PUBLIC_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# CORS. Em producao, informe apenas os dominios reais do frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Banco e fila
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db:5432/videoeditor
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Valores aceitos pelo app: local, s3/minio.
# No docker-compose atual, STORAGE_TYPE usa s3 por default se nao definido.
STORAGE_TYPE=s3
STORAGE_PATH=/app/storage
UPLOADS_PATH=/app/uploads
MAX_UPLOAD_SIZE_MB=2048
MAX_VIDEO_SIZE_MB=2048

# S3/MinIO. Para MinIO interno, S3_INTERNAL_URL pode apontar para a rede Docker
# e S3_PUBLIC_URL para a URL publica usada pelo navegador.
S3_ENDPOINT_URL=
S3_INTERNAL_URL=
S3_PUBLIC_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=videos_agi
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Servicos internos
# -----------------------------------------------------------------------------
# Dentro do gateway, o video_service roda no mesmo container na porta 8001.
VIDEO_SERVICE_URL=http://localhost:8001
VIDEO_EDITOR_API_URL=http://localhost:8001
VIDEO_EDITOR_API_KEY=

# O compose sobe o carousel como servico na rede Docker, mas o compose atual
# tambem define CAROUSEL_SERVICE_URL via host.docker.internal. Use CAROUSEL_API_URL
# para forcar a URL consumida pelas tools.
CAROUSEL_SERVICE_URL=http://localhost:8002
CAROUSEL_API_URL=http://localhost:8002
CAROUSEL_API_KEY=
CAROUSEL_WEBHOOK_URL=
ONBOARDING_WEBHOOK_URL=

REMOTION_SERVICE_URL=http://remotion:8003
STORAGE_DIR=/tmp/remotion-output

# ChatGPT Bridge: proxy OpenAI-compatible que usa auth do Codex/ChatGPT.
# Opcional e separado do LLM de texto. Use apenas se for manter imagem via
# chatgpt-bridge/gpt-image-2.
IMAGE_GEN_PROVIDER=auto
CHATGPT_BRIDGE_URL=http://chatgpt-bridge:10531/v1
CHATGPT_BRIDGE_MODEL=gpt-image-2
CODEX_ACCESS_TOKEN=
CODEX_REFRESH_TOKEN=
CODEX_ID_TOKEN=
CODEX_ACCOUNT_ID=
CODEX_LAST_REFRESH=
CODEX_AUTH_JSON=

# -----------------------------------------------------------------------------
# Perfil recomendado para iniciar pela edicao de video
# -----------------------------------------------------------------------------
# Chat/orquestracao/roteiros usam um provider LLM por API key:
#   MODEL_PROVIDER=openrouter  -> usa OPENROUTER_API_KEY
#   MODEL_PROVIDER=claude      -> usa ANTHROPIC_API_KEY
#   MODEL_PROVIDER=gemini      -> usa GOOGLE_API_KEY
#
# Audio/transcricao NAO usa o provider de texto. Escolha no bloco "Transcricao":
#   TRANSCRIPTION_PROVIDER=openai  -> usa OPENAI_API_KEY e whisper-1
#   TRANSCRIPTION_PROVIDER=groq    -> usa GROQ_API_KEY e whisper-large-v3-turbo
#   TRANSCRIPTION_PROVIDER=local   -> usa faster-whisper local
#
# Para comecar simples: OpenRouter para texto e local para transcricao.

# -----------------------------------------------------------------------------
# LLM principal
# -----------------------------------------------------------------------------
# Valores aceitos: openrouter | claude | gemini.
# Se MODEL_PROVIDER ficar vazio, o backend escolhe automaticamente nesta ordem:
# OPENROUTER_API_KEY -> ANTHROPIC_API_KEY -> GOOGLE_API_KEY.
MODEL_PROVIDER=openrouter

# OpenRouter (recomendado para destravar rapido).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_PLANNER=
OPENROUTER_MODEL_WRITER=
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
OPENROUTER_MODEL_SMART=openai/gpt-4o
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=O Tear

# Claude/Anthropic por API key. Use MODEL_PROVIDER=claude.
ANTHROPIC_API_KEY=

# Gemini por API key. Use MODEL_PROVIDER=gemini.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Selecao granular de modelos para Claude/Gemini ou overrides internos.
MODEL_PLANNER=
MODEL_WRITER=
MODEL_FAST=
MODEL_SMART=

# Cascata usada em alguns fluxos de analise/selecao de clipes.
LLM_CASCADE_ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_CASCADE_OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_CASCADE_OPENAI_MODEL=gpt-4.1-mini
LLM_CASCADE_GEMINI_MODEL=gemini-2.5-flash
LLM_CASCADE_GROQ_MODEL=llama-3.3-70b-versatile
SELECT_CLIPS_ANTHROPIC_MODEL=claude-sonnet-4-6
SELECT_CLIPS_OPENROUTER_MODEL=openai/gpt-4o-mini
SELECT_CLIPS_OPENAI_MODEL=gpt-4.1-mini
SELECT_CLIPS_GEMINI_MODEL=gemini-2.5-flash
SELECT_CLIPS_GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# APIs externas opcionais
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

TAVILY_API_KEY=
NEWS_API_KEY=
YOUTUBE_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=agi-agentes-news-digest/1.0
TWITTERAPI_IO_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# WhatsApp / Evolution API.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=agi
EVOLUTION_WEBHOOK_SECRET=
ALLOWED_NUMBER=

# -----------------------------------------------------------------------------
# Transcricao, video e referencias
# -----------------------------------------------------------------------------
USE_GPU=false
# Valores: openai | groq | local.
# Recomendado para comecar: openai se voce ja tem OPENAI_API_KEY.
# Use groq se tiver GROQ_API_KEY e quiser transcricao rapida/barata.
# Use local se nao quiser gastar API e tiver faster-whisper no ambiente.
TRANSCRIPTION_PROVIDER=openai
CREATOR_WHISPER_MODEL_SIZE=base
CREATOR_EXTRACTION_POSTS=10
MINI_VIDEO_DOWNLOAD_DIR=/app/var/downloads/mini_video_downloads

# Baixe manualmente o modelo se quiser speaker detection com MediaPipe.
# https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
FACE_LANDMARKER_MODEL_PATH=/app/app/workers/models/face_landmarker.task

# -----------------------------------------------------------------------------
# Vault, memoria e orquestracao
# -----------------------------------------------------------------------------
VAULT_PATH=/app/vault
REFERENCES_PATH=/app/storage/references
VAULT_REPO_URL=
VAULT_DEPLOY_TOKEN=

CHAT_ORCHESTRATOR_TIMEOUT_S=120

# Hermes e opcional. Quando true, o entrypoint instala requirements-hermes.txt.
ENABLE_HERMES=false
HERMES_CHAT_TIMEOUT_S=120
HERMES_LLM_PROXY_URL=

# Hermes como cliente externo do O Tear.
# Use estas vars nas skills hermes_skills/otear-orchestrator e agno-bridge.
# OTEAR_API_KEY deve ter o mesmo valor de API_KEY no deploy alvo.
OTEAR_API_URL=http://localhost:8000
OTEAR_API_KEY=
OTEAR_DEFAULT_USER_ID=
OTEAR_DEFAULT_ORG_ID=
OTEAR_DEFAULT_BRAND_ID=
OTEAR_TIMEOUT_S=150

# -----------------------------------------------------------------------------
# News Radar
# -----------------------------------------------------------------------------
NEWS_DIGEST_NICHE=AI agents
NEWS_DIGEST_SUBREDDITS=n8n,AI_Agents,LocalLLaMA

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
