    except Exception as e:
        return {"error": str(e)}

@with_logging("Generate Presigned URL")
def generate_presigned_url_tool(object_key: str, expiration: int = 3600):
    """
    Gera uma URL pré-assinada para acesso temporário a um arquivo no MinIO/S3.
    Use esta ferramenta quando o vídeo estiver no MinIO e não for publicamente acessível.
    
    Args:
        object_key: Caminho do arquivo no bucket (ex: 'stories/teste_jump.mp4')
        expiration: Tempo de validade em segundos (padrão: 3600 = 1 hora)
    
    Returns:
        dict com:
        - url: URL pré-assinada válida temporariamente
        - expires_in: Tempo de validade em segundos
        - object_key: Caminho do arquivo
        - error: Mensagem de erro (se falhar)
    
    Exemplo:
        generate_presigned_url_tool('stories/teste_jump.mp4')
        → {'url': 'https://...?X-Amz-Signature=...', 'expires_in': 3600}
    """
    try:
        import boto3
        from botocore.client import Config
        
        s3_endpoint = os.getenv('S3_ENDPOINT_URL')
        s3_access_key = os.getenv('S3_ACCESS_KEY')
        s3_secret_key = os.getenv('S3_SECRET_KEY')
        s3_bucket = os.getenv('S3_BUCKET_NAME', 'agi')
        s3_region = os.getenv('S3_REGION', 'us-east-1')
        
        if not all([s3_endpoint, s3_access_key, s3_secret_key]):
            return {"error": "Credenciais do MinIO/S3 não configuradas no .env"}
        
        # Remove trailing slash from endpoint
        s3_endpoint = s3_endpoint.rstrip('/')
        
        logger.info(f"[PRESIGNED URL] Gerando para {object_key} no bucket {s3_bucket}")
        
        s3_client = boto3.client(
            's3',
            endpoint_url=s3_endpoint,
            aws_access_key_id=s3_access_key,
            aws_secret_access_key=s3_secret_key,
            config=Config(signature_version='s3v4'),
            region_name=s3_region
        )
        
        presigned_url = s3_client.generate_presigned_url(
            'get_object',
            Params={'Bucket': s3_bucket, 'Key': object_key},
            ExpiresIn=expiration
        )
        
        logger.info(f"[PRESIGNED URL] ✓ Gerada com sucesso, válida por {expiration}s")
        logger.info(f"[PRESIGNED URL] URL: {presigned_url[:100]}...")
        
        return {
            "url": presigned_url,
            "expires_in": expiration,
            "object_key": object_key,
            "bucket": s3_bucket
        }
        
    except ImportError:
        error_msg = "boto3 não instalado. Execute: pip install boto3"
        logger.error(f"[PRESIGNED URL] {error_msg}")
        return {"error": error_msg}
    except Exception as e:
        error_msg = f"Erro ao gerar presigned URL: {str(e)}"
        logger.error(f"[PRESIGNED URL] {error_msg}")
        return {"error": error_msg}

def edit_video_tool(video_url: str, operations: List[Dict[str, Any]] = None, operation_type: str = None, params: Dict[str, Any] = None, preset: str = None) -> Dict[str, Any]:
    """
    FERRAMENTA OBRIGATÓRIA para editar vídeos. SEMPRE use esta ferramenta quando precisar processar vídeos.
    
    Args:
        video_url: URL do vídeo a ser editado (OBRIGATÓRIO - deve começar com http:// ou https://).
        preset: Nome do preset predefinido - USE ESTE PARÂMETRO PRIMEIRO (mais simples):
                'VIRAL' - Legendas amarelas word-by-word + remoção de silêncio (RECOMENDADO para Reels/Shorts)
                'MODERN_SUBTITLES' - Legendas brancas com destaque por palavra
                'REACTION' - Otimizado para vídeos de reação com overlay
                'CLEAN' - Remoção de silêncio + legendas estáticas
        operations: Lista de operações customizadas (use apenas se preset não atender). Cada operação é um dict com 'type' e 'params'.
                    Exemplo: [
                        {"type": "add_text_overlay", "params": {"text": "Título", "position": "top", "padding_top": 60}},
                        {"type": "auto_subtitle", "params": {"style": {"font_size": 10, "color": "#FFFF00"}}}
                    ]
    
    Returns:
        dict com:
        - 'download_url': URL do vídeo processado (quando completo)
        - 'status': 'completed', 'processing', ou 'failed'
        - 'id': Job ID para verificar status
        - 'error': Mensagem de erro (se falhar)
    
    IMPORTANTE: Esta ferramenta aguarda até 3 minutos pelo processamento. Se retornar sem 'download_url',
    use check_video_status_tool(job_id) para verificar o progresso.
    
    Operações disponíveis (para uso com 'operations'):
        - add_text_overlay: Adiciona texto sobre o vídeo
            params: {text, position, padding_top, font_size, color, background_color}
        - auto_subtitle: Adiciona legendas automáticas
            params: {style: {font_size, color, position, animation}}
        - remove_silence: Remove silêncios do vídeo
        - video_overlay: Adiciona vídeo sobreposto
            params: {overlay_url, position, scale, chroma_key}
    """
    # Logging manual
    logger.info(f"[VIDEO TOOL] Iniciando edição de vídeo: {video_url}")
    
    try:
        # Validação de entrada
        if not video_url:
            return {"error": "ERRO: video_url é obrigatório. Forneça a URL do vídeo a ser editado."}
        
        if not video_url.startswith(("http://", "https://")):
            return {"error": f"ERRO: video_url deve ser uma URL válida (começando com http:// ou https://). Recebido: {video_url}"}
        
        url = f"{VIDEO_SERVICE_URL}/api/v1/videos/edit"
        
        # Build operations list
        ops = []
        
        # Prioritize preset if provided
        if preset:
            valid_presets = ['VIRAL', 'MODERN_SUBTITLES', 'REACTION', 'CLEAN']
            if preset.upper() not in valid_presets:
                return {"error": f"ERRO: Preset inválido '{preset}'. Use um dos seguintes: {', '.join(valid_presets)}"}
            ops.append({"type": "preset", "params": {"name": preset.upper()}})
        # Then check for operations list (new format)
        elif operations and isinstance(operations, list):
            ops = operations
        # Fallback to single operation (legacy format)
        elif operation_type:
            ops.append({"type": operation_type, "params": params or {}})
        
        if not ops:
            return {"error": "ERRO: Nenhuma operação especificada. Forneça 'preset' (recomendado) ou 'operations'."}
        
        # Garantir que todas as operações auto_subtitle tenham font_size: 10
        for op in ops:
            if op.get("type") == "auto_subtitle":
                if "params" not in op:
                    op["params"] = {}
                if "style" not in op["params"]:
                    op["params"]["style"] = {}
                # Sempre definir font_size como 10
                op["params"]["style"]["font_size"] = 10
            
        payload = {
            "video_url": video_url,
            "operations": ops,
            "output_format": "mp4"
        }
        
        headers = {}
        if VIDEO_SERVICE_KEY:
            headers["x-api-key"] = VIDEO_SERVICE_KEY
        
        logger.info(f"[VIDEO TOOL] Calling API: {url}")
        logger.info(f"[VIDEO TOOL] Video URL: {video_url}")
        logger.info(f"[VIDEO TOOL] Operations: {json.dumps(ops)}")
            
        # The Video API expects Form Data with a 'request' field containing the JSON
        response = httpx.post(
            url, 
            data={"request": json.dumps(payload)},
            headers=headers,
            timeout=120.0
        )
        
        if response.status_code != 200:
            error_msg = f"API retornou status {response.status_code}: {response.text}"
            logger.error(f"[VIDEO TOOL] {error_msg}")
            return {"error": error_msg}
            
        result = response.json()
        logger.info(f"[VIDEO TOOL] Initial response: {json.dumps(result)}")
        
        # POLL FOR COMPLETION
        job_id = result.get("id") or result.get("task_id")
        if not job_id:
            logger.error(f"[VIDEO TOOL] No job_id in response: {result}")
            return {"error": "ERRO: API não retornou job_id. Resposta: " + str(result)}
        
        logger.info(f"[VIDEO TOOL] Job {job_id} criado. Iniciando verificação progressiva (checagem a cada 5 min).")
        import time
        
        # 6 tentativas * 5 minutos = 30 minutos de timeout total
        max_retries = 6
        
        for i in range(max_retries):
            # Espera 5 minutos (300s) ANTES de checar/rechecar
            logger.info(f"[VIDEO TOOL] Aguardando 5 minutos... (Tentativa {i+1}/{max_retries})")
            time.sleep(300)
            
            try:
                status_url = f"{VIDEO_SERVICE_URL}/api/v1/videos/status/{job_id}"
                logger.info(f"[VIDEO TOOL] Verificando status: GET {status_url}")
                status_response = httpx.get(status_url, headers=headers, timeout=30.0)
                
                if status_response.status_code == 200:
                    job_status = status_response.json()
                    state = job_status.get("status")
                    progress = job_status.get('progress', 0)
                    
                    # Log a cada verificação para debug
                    logger.info(f"[VIDEO TOOL] Job {job_id} - Status: {state}, Progress: {progress}%")
                    
                    if state == "completed":
                        download_url = job_status.get("download_url")
                        if download_url:
                            # Se a URL for relativa (/static/...), construir URL completa
                            if download_url.startswith("/"):
                                # Remove trailing slash from base URL to avoid double slashes
                                base_url = VIDEO_SERVICE_URL.rstrip("/")
                                full_url = f"{base_url}{download_url}"
                                logger.info(f"[VIDEO TOOL] ✓ Job {job_id} COMPLETO! URL relativa convertida: {download_url} -> {full_url}")
                                return {
                                    "status": "completed",
                                    "id": job_id,
                                    "download_url": full_url,
                                    "message": "Vídeo processado com sucesso!"
                                }
                            else:
                                logger.info(f"[VIDEO TOOL] ✓ Job {job_id} COMPLETO! URL: {download_url}")
                                return {
                                    "status": "completed",
                                    "id": job_id,
                                    "download_url": download_url,
                                    "message": "Vídeo processado com sucesso!"
                                }
                        else:
                            logger.warning(f"[VIDEO TOOL] Job completo mas sem download_url: {job_status}")
                            return job_status
                            
                    elif state == "failed":
                        error = job_status.get('error_message', 'Erro desconhecido')
                        logger.error(f"[VIDEO TOOL] ✗ Job {job_id} FALHOU: {error}")
                        return {
                            "status": "failed",
                            "id": job_id,
                            "error": f"Processamento falhou: {error}"
                        }
                    else:
                        # Still processing - log mais frequente
                        if i % 5 == 0:  # A cada 10 segundos
                            logger.info(f"[VIDEO TOOL] Job {job_id} processando... {progress}% ({i*2}s/{max_retries*2}s)")
                else:
                    logger.warning(f"[VIDEO TOOL] Status check falhou: {status_response.status_code} - {status_response.text}")

            except Exception as e:
                logger.warning(f"[VIDEO TOOL] Erro ao verificar status: {e}")
        
        # If timeout
        logger.warning(f"[VIDEO TOOL] ⏱ Job {job_id} timeout após {max_retries*2}s")
        return {
            "status": "processing",
            "id": job_id,
            "message": f"Vídeo ainda processando após {max_retries*2}s. IMPORTANTE: Guarde este job_id e use check_video_status_tool('{job_id}') para verificar o progresso."
        }
            
    except httpx.HTTPError as e:
        error_msg = f"Erro de conexão com o serviço de vídeo: {str(e)}"
        logger.error(f"[VIDEO TOOL] {error_msg}")
        return {"error": error_msg}
    except Exception as e:
        error_msg = f"Erro inesperado: {type(e).__name__} - {str(e)}"
        logger.error(f"[VIDEO TOOL] {error_msg}")
        return {"error": error_msg}
    finally:
        logger.info(f"[VIDEO TOOL] Finalizando execução")
        if not ops:
            return {"error": "ERRO: Nenhuma operação especificada. Forneça 'preset' (recomendado) ou 'operations'."}
        
        # Garantir que todas as operações auto_subtitle tenham font_size: 10
        for op in ops:
            if op.get("type") == "auto_subtitle":
                if "params" not in op:
                    op["params"] = {}
                if "style" not in op["params"]:
                    op["params"]["style"] = {}
                # Sempre definir font_size como 10
                op["params"]["style"]["font_size"] = 10
            
        payload = {
            "video_url": video_url,
            "operations": ops,
            "output_format": "mp4"
        }
        
        headers = {}
        if VIDEO_SERVICE_KEY:
            headers["x-api-key"] = VIDEO_SERVICE_KEY
        
        logger.info(f"[VIDEO TOOL] Calling API: {url}")
        logger.info(f"[VIDEO TOOL] Video URL: {video_url}")
        logger.info(f"[VIDEO TOOL] Operations: {json.dumps(ops)}")
            
        # The Video API expects Form Data with a 'request' field containing the JSON
        response = httpx.post(
            url, 
            data={"request": json.dumps(payload)},
            headers=headers,
            timeout=120.0
        )
        
        if response.status_code != 200:
            error_msg = f"API retornou status {response.status_code}: {response.text}"
            logger.error(f"[VIDEO TOOL] {error_msg}")
            return {"error": error_msg}
            
        result = response.json()
        logger.info(f"[VIDEO TOOL] Initial response: {json.dumps(result)}")
        
        # POLL FOR COMPLETION
        job_id = result.get("id") or result.get("task_id")
        if not job_id:
            logger.error(f"[VIDEO TOOL] No job_id in response: {result}")
            return {"error": "ERRO: API não retornou job_id. Resposta: " + str(result)}
        
        logger.info(f"[VIDEO TOOL] Job {job_id} criado. Iniciando verificação progressiva (checagem a cada 5 min).")
        import time
        
        # 6 tentativas * 5 minutos = 30 minutos de timeout total
        max_retries = 6
        
        for i in range(max_retries):
            # Espera 5 minutos (300s) ANTES de checar/rechecar
            logger.info(f"[VIDEO TOOL] Aguardando 5 minutos... (Tentativa {i+1}/{max_retries})")
            time.sleep(300)
            
            try:
                status_url = f"{VIDEO_SERVICE_URL}/api/v1/videos/status/{job_id}"
                logger.info(f"[VIDEO TOOL] Verificando status: GET {status_url}")
                status_response = httpx.get(status_url, headers=headers, timeout=30.0)
                
                if status_response.status_code == 200:
                    job_status = status_response.json()
                    state = job_status.get("status")
                    progress = job_status.get('progress', 0)
                    
                    # Log a cada verificação para debug
                    logger.info(f"[VIDEO TOOL] Job {job_id} - Status: {state}, Progress: {progress}%")
                    
                    if state == "completed":
                        download_url = job_status.get("download_url")
                        if download_url:
                            # Se a URL for relativa (/static/...), construir URL completa
                            if download_url.startswith("/"):
                                # Remove trailing slash from base URL to avoid double slashes
                                base_url = VIDEO_SERVICE_URL.rstrip("/")
                                full_url = f"{base_url}{download_url}"
                                logger.info(f"[VIDEO TOOL] ✓ Job {job_id} COMPLETO! URL relativa convertida: {download_url} -> {full_url}")
                                return {
                                    "status": "completed",
                                    "id": job_id,
                                    "download_url": full_url,
                                    "message": "Vídeo processado com sucesso!"
                                }
                            else:
                                logger.info(f"[VIDEO TOOL] ✓ Job {job_id} COMPLETO! URL: {download_url}")
                                return {
                                    "status": "completed",
                                    "id": job_id,
                                    "download_url": download_url,
                                    "message": "Vídeo processado com sucesso!"
                                }
                        else:
                            logger.warning(f"[VIDEO TOOL] Job completo mas sem download_url: {job_status}")
                            return job_status
                            
                    elif state == "failed":
                        error = job_status.get('error_message', 'Erro desconhecido')
                        logger.error(f"[VIDEO TOOL] ✗ Job {job_id} FALHOU: {error}")
                        return {
                            "status": "failed",
                            "id": job_id,
                            "error": f"Processamento falhou: {error}"
                        }
                    else:
                        # Still processing - log mais frequente
                        if i % 5 == 0:  # A cada 10 segundos
                            logger.info(f"[VIDEO TOOL] Job {job_id} processando... {progress}% ({i*2}s/{max_retries*2}s)")
                else:
                    logger.warning(f"[VIDEO TOOL] Status check falhou: {status_response.status_code} - {status_response.text}")

            except Exception as e:
                logger.warning(f"[VIDEO TOOL] Erro ao verificar status: {e}")
        
        # If timeout
        logger.warning(f"[VIDEO TOOL] ⏱ Job {job_id} timeout após {max_retries*2}s")
        return {
            "status": "processing",
            "id": job_id,
            "message": f"Vídeo ainda processando após {max_retries*2}s. IMPORTANTE: Guarde este job_id e use check_video_status_tool('{job_id}') para verificar o progresso."
        }
            
    except httpx.HTTPError as e:
        error_msg = f"Erro de conexão com o serviço de vídeo: {str(e)}"
        logger.error(f"[VIDEO TOOL] {error_msg}")
        return {"error": error_msg}
    except Exception as e:
        error_msg = f"Erro inesperado: {type(e).__name__} - {str(e)}"
        logger.error(f"[VIDEO TOOL] {error_msg}")
        return {"error": error_msg}
    finally:
        logger.info(f"[VIDEO TOOL] Finalizando execução")

@with_logging("Check Video Status")
def check_video_status_tool(job_id: str):
    """
    Checks the status of a video editing job and converts relative URLs to absolute.
    """
    try:
        url = f"{VIDEO_SERVICE_URL}/api/v1/videos/status/{job_id}"
        headers = {}
        if VIDEO_SERVICE_KEY:
            headers["x-api-key"] = VIDEO_SERVICE_KEY
            
        response = httpx.get(url, headers=headers, timeout=10.0)
        result = response.json()
        
        # Convert relative download_url to absolute if present
        if result.get("status") == "completed" and result.get("download_url"):
            download_url = result["download_url"]
            if download_url.startswith("/"):
                base_url = VIDEO_SERVICE_URL.rstrip("/")
                result["download_url"] = f"{base_url}{download_url}"
                logger.info(f"[CHECK STATUS] Converted relative URL: {download_url} -> {result['download_url']}")
        
        return result
    except Exception as e:
        logger.error(f"Error checking video status: {e}")
        return {"error": str(e)}

@with_logging("Transcribe Video")
def transcribe_video_tool(video_url: str):
    """
    Transcribes a video.
    """
    try:
        url = f"{VIDEO_SERVICE_URL}/api/v1/videos/transcribe"
        headers = {}
        if VIDEO_SERVICE_KEY:
            headers["x-api-key"] = VIDEO_SERVICE_KEY
            
        response = httpx.post(url, data={"video_url": video_url}, headers=headers, timeout=60.0)
        return response.json()
    except Exception as e:
        logger.error(f"Error transcribing video: {e}")
        return {"error": str(e)}

def list_creators_tool():
    """
