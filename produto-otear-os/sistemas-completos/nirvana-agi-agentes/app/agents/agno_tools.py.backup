    return ["Tiago Aguiar", "Ícaro de Carvalho", "Joel J", "Clarice Lispector"]

def get_creator_style_tool(creator_name: str):
    """
    Gets the writing style patterns for a specific creator.
    """
    styles = {
        "Tiago Aguiar": "Direto, técnico, foca em código e carreira dev.",
        "Ícaro de Carvalho": "Agressivo, filosófico, foca em marketing e vida digital.",
        "Joel J": "Energético, alta performance, foca em disciplina e esporte."
    }
    return styles.get(creator_name, "Estilo padrão: educativo e profissional.")

@with_logging("Generate Image")
def generate_image_tool(prompt: str):
    """
    Generates an image based on a prompt using Google's Imagen 3 model.
    """
    api_key = os.getenv("GOOGLE_API_KEY")
    if not api_key:
        return {"error": "GOOGLE_API_KEY not found."}

    try:
        from google import genai
        from google.genai import types
        import base64
        import uuid

        client = genai.Client(api_key=api_key)
        
        # Using Imagen 3 model
        response = client.models.generate_images(
            model='imagen-3.0-generate-001',
            prompt=prompt,
            config=types.GenerateImagesConfig(
                number_of_images=1,
            )
        )
        
        # API returns raw bytes or base64? SDK usually returns object with image_bytes or similar.
        # Check response structure logic:
        if not response.generated_images:
            return {"error": "No image generated."}
            
        image_data = response.generated_images[0].image.image_bytes
        
        # Save to static path
        filename = f"gen-{uuid.uuid4()}.png"
        storage_path = os.getenv("STORAGE_PATH", "/app/storage")
        os.makedirs(storage_path, exist_ok=True)
        filepath = os.path.join(storage_path, filename)
        
        with open(filepath, "wb") as f:
            f.write(image_data)
            
        # Return URL
        port = os.getenv("PORT", "8000")
        # Assuming /static/ is mounted to STORAGE_PATH
        image_url = f"http://localhost:{port}/static/{filename}"
        
        return {"url": image_url, "prompt": prompt}
        
    except Exception as e:
        logger.error(f"Error generating image with Google: {e}")
        return {"error": f"Google GenAI Error: {str(e)}"}

# --- KNOWLEDGE BASE TOOLS FOR DONA ---

KNOWLEDGE_PATH = os.path.join(os.path.dirname(os.path.dirname(__file__)), "knowledge")

def _read_kb_file(filename: str):
    try:
        path = os.path.join(KNOWLEDGE_PATH, filename)
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except Exception as e:
        logger.error(f"Error reading knowledge base file {filename}: {e}")
        return f"Erro ao ler base de conhecimento: {str(e)}"

@with_logging("Read KB: Base")
def read_base_tool():
    """
    Busca o conhecimento técnico para fazer o roteiro.
    """
    return _read_kb_file("base.md")

