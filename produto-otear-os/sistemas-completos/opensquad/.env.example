# Opensquad — Environment Variables
# Copie este arquivo para .env e preencha suas chaves.

# Supabase (banco de noticias e imagens)
# Obtenha em: Supabase Dashboard > Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (variaveis publicas para o browser)
# A mesma URL do SUPABASE_URL e a anon key (nao a service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Diretorio raiz para dados de tenants (padrao: ./data)
# DATA_ROOT=

# Redis (fila de jobs — obrigatorio para SaaS multi-tenant)
REDIS_URL=redis://localhost:6379

# Worker concurrency (quantos runs simultaneos — limitado pela subscription Claude)
# WORKER_CONCURRENCY=1

# WebSocket Gateway (porta para real-time updates do escritorio)
# WS_PORT=3001
# NEXT_PUBLIC_WS_PORT=3001

# Google Gemini API Key (para geracao de imagens)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Brave Search API Key (para coleta de noticias — opcional, fallback: Google News RSS)
# Obtenha em: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Google Custom Search (banco de fotos de pessoas — busca e cache no Supabase)
# Obtenha em: https://programmablesearchengine.google.com/controlpanel/all
# Ative: "Search images" e "Search entire web"
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# R2 / S3 (banco de imagens persistente — opcional)
# Obtenha em: Cloudflare Dashboard > R2 > Manage API Tokens
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# Instagram (login automatico para analise de perfil / estilo visual)
# Conta usada pelo Playwright para acessar perfis do Instagram
# Recomendacao: use conta secundaria, desative 2FA
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Anthropic API Key (alternativa ao OAuth — para Claude Vision na analise de perfil)
# Obtenha em: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Claude CLI OAuth (sessao autenticada - usa seu plano Pro/Max sem API key)
# Para obter: rode "claude login" localmente e copie de ~/.claude/.credentials.json
# Os valores estao no campo "claudeAiOauth"
CLAUDE_OAUTH_ACCESS_TOKEN=
CLAUDE_OAUTH_REFRESH_TOKEN=
CLAUDE_OAUTH_EXPIRES_AT=
